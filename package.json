{
  "name": "zen-gomoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,css,json}\" \"docs/**/*.md\" \"*.md\" \".cursor/**/*.mdc\"",
    "format:check": "prettier --check \"docs/**/*.md\" \"*.md\" \".cursor/**/*.mdc\"",
    "generate:teacher-records": "tsx scripts/generate-teacher-records.ts",
    "import:wuziqi123": "tsx scripts/import-wuziqi123.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,css,json}": [
      "prettier --write"
    ],
    "*.{md,mdc}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.1.5"
  }
}
